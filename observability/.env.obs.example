# Coroot stack configuration. Copy to `.env.obs` and edit as needed.
#
# Loaded by docker compose via `--env-file observability/.env.obs`.
# `.env.obs` itself is gitignored; only this `.example` is committable.

# ── Image versions ──────────────────────────────────────────────────────
# Pinned for reproducibility; bump deliberately when you want to test
# a new Coroot release. The upstream compose uses :latest with
# pull_policy: always, which is fine for production but bad for an
# experiment trying to compare against a specific behaviour.
COROOT_VERSION=1.10.0
NODE_AGENT_VERSION=1.21.0
CLUSTER_AGENT_VERSION=1.5.0

# ── Host port ──────────────────────────────────────────────────────────
# The Coroot UI. Default 8080 collides with a sibling demo container
# on this dev box; 18080 is free. Production would map this to 80/443
# behind a reverse proxy.
COROOT_HOST_PORT=18080
