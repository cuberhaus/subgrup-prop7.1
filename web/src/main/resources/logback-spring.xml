<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON-line stdout for the PROP backend.

  Two consumers care about this format:
   1. The PersonalPortfolio log-relay sidecar tails this container's
      stdout and forwards each line into the in-page debug overlay (the
      relay does not have to guess at parsing free-form text).
   2. On the obs-experiment-coroot branch, Coroot's container-log
      scraper indexes the JSON fields as structured key/value attributes
      on each log line — including any MDC keys (notably session_id,
      stamped by SessionIdFilter on requests that carry X-Session-Id).

  The Sentry SentryAppender that used to attach automatically here (via
  the io.sentry:sentry-logback dependency) is gone with Sentry removal
  in Phase 2 of the Coroot PoC.
-->
<configuration>
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>ts</timestamp>
                <message>msg</message>
                <logger>ns</logger>
                <level>level</level>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT_JSON"/>
    </root>
</configuration>
